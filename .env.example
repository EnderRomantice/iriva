# Production uses a restricted server-side PostgreSQL role via the Supabase
# Transaction pooler. Copy the actual URI from Connect; never expose this URL.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Migration only: the admin connection, loaded explicitly by the migration CLI.
# Keep it in .env.supabase.local, not in the browser or deployed app.
SUPABASE_DATABASE_URL=

# Optional during loopback-only development: without these, OTPs are printed
# in the Next.js server terminal. No email is sent. Production requires both.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
