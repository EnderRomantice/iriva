# Production uses a restricted server-side PostgreSQL role via the Supabase
# Transaction pooler. Copy the actual URI from Connect; never expose this URL.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Migration only: the admin connection, loaded explicitly by the migration CLI.
# Keep it in .env.supabase.local, not in the browser or deployed app.
SUPABASE_DATABASE_URL=

# Optional during loopback-only development: without these, OTPs are printed
# in the Next.js server terminal. No email is sent. Production requires both.
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# Iriva assistant (Wayline runtime). Server only.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=provider/model

# Stripe Payment Link must charge CNY 1,980 for the Native four-week plan.
STRIPE_PAYMENT_LINK=https://buy.stripe.com/00wdRa6Lzffy2ad7j83ZK00
# Subscribe /api/stripe/webhook to checkout.session.completed,
# checkout.session.async_payment_succeeded and charge.refunded.
STRIPE_WEBHOOK_SECRET=

# Audio-capable model, invoked only by an administrator clicking AI assessment.
ORAL_ASSESSMENT_MODEL=google/gemini-2.5-flash
